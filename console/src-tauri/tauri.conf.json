{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Console Eden Dev",
  "mainBinaryName": "console-eden-dev",
  "version": "1.2.0",
  "identifier": "com.edendev.console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Console Eden Dev",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://wpuchfnyuyujdflbmqpn.supabase.co wss://wpuchfnyuyujdflbmqpn.supabase.co https://github.com https://objects.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "shortDescription": "Administration de GestiMarket (Eden Dev)",
    "longDescription": "Console Eden Dev : comptes et boutiques GestiMarket, licences, cartes de bon (vente par WhatsApp), validation des paiements Orange Money, Wave et Moov, réglages. Réservée à l'équipe Eden Dev.",
    "publisher": "Eden Dev",
    "copyright": "Eden Dev",
    "android": {
      "minSdkVersion": 24
    },
    "windows": {
      "nsis": {
        "languages": ["French"],
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5RTQ5NzVERUUxRTRFQjAKUldTd1RoN3VYWmZrZWFZTm1jTlQ2YmErNWxobGJoWGQxdGJNYUJaQVJFOXFtQTY5RlZhU3NtdWQK",
      "endpoints": [
        "https://github.com/lasscientifique/gestimarket/releases/download/console/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
