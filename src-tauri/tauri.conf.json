{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GestiMarket",
  "version": "0.31.0",
  "identifier": "com.gestimarket.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "GestiMarket — Gestion commerciale",
        "width": 1366,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: media: http://media.localhost https://media.localhost http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob: aide: http://aide.localhost https://aide.localhost http: https:; connect-src ipc: http://ipc.localhost http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Gestion de supermarché et de boutiques",
    "longDescription": "GestiMarket : caisse avec écran client, Orange Money / Sarali, catégories et sous-catégories, emplacements (bloc, étage, rangée), multi-postes en réseau, stock, achats, clients et crédit, rapports.",
    "publisher": "GestiMarket",
    "copyright": "Eden Dev",
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "customLanguageFiles": {
          "French": "nsis/French.nsh"
        },
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5RTQ5NzVERUUxRTRFQjAKUldTd1RoN3VYWmZrZWFZTm1jTlQ2YmErNWxobGJoWGQxdGJNYUJaQVJFOXFtQTY5RlZhU3NtdWQK",
      "endpoints": [
        "https://github.com/lasscientifique/gestimarket/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
